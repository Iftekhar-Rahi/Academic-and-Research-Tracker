# Copy this file to ".env" and fill in your own values.
# Get MONGO_URI from MongoDB Atlas: Database > Connect > Drivers > copy the connection string
# (replace <password> with your database user's password, and add a database name at the end, e.g. /tracker)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tracker

# Any long random string works. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

# Must match the dev proxy target in frontend/vite.config.js, or the React app's
# /api calls will not reach this server.
PORT=5001
